# Letter analysis (hosted Gemma through Gemini API — no model download)
GEMMA_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=models/gemma-4-26b-a4b-it

# Optional local fallback: set GEMMA_PROVIDER=ollama, then pull these models.
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:26b
EMBED_MODEL=embeddinggemma

# Local storage: photos in data/uploads/<id>/, everything else in data/letters.db (gitignore data/!)
DATA_DIR=data

# ElevenLabs Agents (native Twilio integration)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=            # the "Digital Phone Assistant" agent
ELEVENLABS_PHONE_NUMBER_ID=     # ID of the imported Twilio number (ElevenLabs → Phone Numbers)

# How calls are placed: phone (dial via the Twilio number above), browser (free demo, no telephony:
# a second device answers at /hotline/<id>), or auto = phone once ELEVENLABS_PHONE_NUMBER_ID is set.
CALL_MODE=auto
# ELEVENLABS_API_URL=https://api.eu.residency.elevenlabs.io   # only for EU data residency accounts

# Language each call starts in. German authorities answer in German; the agent can still switch.
AGENT_LANGUAGE=de

# Phone the agent transfers to when a person answers (E.164). `pnpm agent:sync` writes it to the agent.
TRANSFER_NUMBER=

# Public HTTPS URL of this app so the agent's report_status webhook can reach it.
# Leave empty with a cloudflared quick tunnel: `pnpm agent:sync` finds the URL itself.
TUNNEL_URL=

# Twilio (only needed for "End call" in the app)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Shared secret: the app sends it with each call, the report_status tool sends it back as x-webhook-secret
WEBHOOK_SECRET=change-me

# Name the agent introduces you with
USER_DISPLAY_NAME=Kevin

# Demo safety net: if set, EVERY call goes here (your mock hotline) instead of the number on the letter
DEMO_TARGET_NUMBER=
